{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_*",
    "SUPABASE_*",
    "SENTRY_*",
    "UPSTASH_*",
    "OPENROUTER_API_KEY",
    "GEMINI_API_KEY",
    "APP_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "storybook-static/**"
      ]
    },
    "generate": {
      "outputs": [
        "src/generated/**",
        "src/types/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:e2e": {
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    }
  }
}
