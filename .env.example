# Public app URL (used for email links, OAuth callbacks, admin fetch)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_JWT_SECRET=replace-with-project-jwt-secret
# Aliases used by db integration tests (packages/db/tests/setup.ts)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key

DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Optional Supabase shared-pooler override for serverless/Vercel.
# Copy the HOSTNAME only (not a full URI) from Supabase Dashboard > Connect > Transaction pooler.
# The pooler host includes a cluster index; do not derive it from the region.
# The client preserves the existing password in DATABASE_URL.
# SUPABASE_DB_POOLER_HOST=aws-<index>-<region>.pooler.supabase.com
# SUPABASE_DB_POOLER_PORT=6543
# SUPABASE_PROJECT_REF=your-project-ref

# Observability
SENTRY_DSN=
SENTRY_AUTH_TOKEN=              # server only, source map upload
LOG_LEVEL=info                  # debug in dev, info in prod

# OpenTelemetry (optional — recommended for pre-launch with real traffic)
# Set to enable distributed tracing (spans: http.request → chat.route → provider.call → db.insert)
# Leave unset to disable (structured logs are sufficient for most debugging).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1    # 10% sampling in prod; 1.0 = all traces

# PostHog (product analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Upstash Redis (rate limiting + stream buffering)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email
EMAIL_FROM=no-reply@supa-ai.example

# LLM provider keys — at least one must be set for chat to work.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Email + cron
RESEND_API_KEY=
CRON_SECRET=

# Invite token HMAC secret — falls back to SUPABASE_SERVICE_ROLE_KEY if unset.
# Generate a strong random string (32+ bytes) for production.
INVITE_TOKEN_SECRET=

# Test-only — gates /api/test/* endpoints. Set this in staging/non-prod
# to require `Authorization: Bearer <secret>` for test endpoints.
# Leave unset in local dev (endpoints are open when NODE_ENV !== 'production').
TEST_API_SECRET=

TURBO_TOKEN=
TURBO_TEAM=

# 32-byte hex key for AES-256-GCM sensitive-field encryption (server secret only).
SENSITIVE_DATA_ENCRYPTION_KEY=
